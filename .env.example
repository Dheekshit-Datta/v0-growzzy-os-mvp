# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# App/Auth
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_SECRET="replace-with-a-generated-secret"
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-chars"

# AI
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_CREATIVE_MODEL="gpt-4o"
OPENAI_CAMPAIGN_BUILDER_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="gpt-image-1"

# Google OAuth / Google Ads
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
NEXT_PUBLIC_GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_ADS_DEVELOPER_TOKEN="replace-with-google-ads-developer-token"
GOOGLE_ADS_API_VERSION="v22"

# Meta OAuth / Ads
ENABLE_META_ADS="false"
NEXT_PUBLIC_ENABLE_META_ADS="false"
META_APP_ID="replace-with-meta-app-id"
NEXT_PUBLIC_META_APP_ID="replace-with-meta-app-id"
META_APP_SECRET="replace-with-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"
NEXT_PUBLIC_META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"
META_GRAPH_API_VERSION="v19.0"

# Redis-backed rate limiting
UPSTASH_REDIS_REST_URL="replace-with-upstash-redis-rest-url"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-redis-rest-token"

# Webhooks/Cron
GOOGLE_LEADS_WEBHOOK_SECRET="replace-with-google-leads-webhook-secret"
CRON_SECRET="replace-with-cron-secret"

# Email
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-password"
FROM_EMAIL="Growzzy <noreply@example.com>"
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="Growzzy <noreply@example.com>"

# Optional observability
NEXT_PUBLIC_GA_ID=""
SENTRY_DSN=""
